# MCP Server Dockerfile
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy pyproject.toml and source code (needed for -e install)
COPY pyproject.toml .
COPY src/ ./src/

# Install Python dependencies from pyproject.toml
RUN pip install --no-cache-dir -e .

# Create logs directory
RUN mkdir -p logs

# Expose MCP server port
EXPOSE 8001

# Health check - check if server responds (any HTTP response means server is up)
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -s -o /dev/null -w "%{http_code}" http://localhost:8001/mcp | grep -q "[0-9]" || exit 1

# Run MCP server with HTTP transport (FastMCP http_app)
CMD ["python", "-m", "src.mcp.server"]
