# MAXA Data Scientist Backend - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Google Cloud Platform (Required for Vertex AI)
# ============================================================================
# GCP project ID for Vertex AI
GOOGLE_CLOUD_PROJECT=your-project-id

# GCP location for Vertex AI (e.g., us-central1, global)
GOOGLE_CLOUD_LOCATION=global

# Alternative project ID environment variable (for backward compatibility)
# GCP_PROJECT_ID=your-project-id


# ============================================================================
# Snowflake (Optional - only if using data warehouse features)
# ============================================================================
# Snowflake account identifier (format: account.region)
# SNOWFLAKE_ACCOUNT=myaccount.us-east-1

# Snowflake credentials
# SNOWFLAKE_USER=your_username
# SNOWFLAKE_PASSWORD=your_password

# Snowflake resource names
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=MY_DATABASE
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_ROLE=SYSADMIN

# Alternative: Private key authentication (instead of password)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/private_key.pem
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=optional_passphrase


# ============================================================================
# MCP Server Configuration
# ============================================================================
# MCP server URL (for HTTP mode - when using Docker Compose)
MCP_URL=http://localhost:8001

# Legacy MCP server URL (for backward compatibility)
# MCP_SERVER_URL=http://localhost:9000/mcp

# MCP transport protocol (stdio or http)
# - stdio: Recommended for local development (spawns subprocess)
# - http: For Docker Compose / remote MCP servers (RECOMMENDED)
MCP_TRANSPORT=http

# MCP timeout in seconds (1-300)
MCP_TIMEOUT=30


# ============================================================================
# Agent Configuration
# ============================================================================
# Claude model to use (claude-sonnet-4, claude-opus-4, etc.)
AGENT_MODEL=claude-sonnet-4

# Maximum iterations per execution (1-200)
AGENT_MAX_ITERATIONS=50

# Maximum tokens in context (1000-200000)
AGENT_MAX_TOKENS=100000

# Enable streaming responses (true/false)
AGENT_ENABLE_STREAMING=false


# ============================================================================
# Redis (Required for job tracking and session storage)
# ============================================================================
# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Maximum Redis connection pool size (1-100)
REDIS_MAX_CONNECTIONS=10

# Session TTL in seconds (60-2592000, default: 86400 = 24 hours)
REDIS_SESSION_TTL=86400

# Redis key prefix for session keys
REDIS_KEY_PREFIX=session:


# ============================================================================
# MongoDB (Required for API mode session persistence)
# ============================================================================
# MongoDB server connection
MONGODB_HOST=localhost
MONGODB_PORT=27017

# MongoDB credentials
MONGODB_USERNAME=admin
MONGODB_PASSWORD=admin123

# MongoDB database configuration
MONGODB_DATABASE=maxa_sessions
MONGODB_AUTH_SOURCE=admin


# ============================================================================
# MinIO (Required for large DataFrame storage)
# ============================================================================
# MinIO server endpoint (host:port, without http://)
MINIO_ENDPOINT=localhost:9010

# MinIO credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO bucket for session data
MINIO_BUCKET=maxa-sessions

# Use HTTPS for MinIO connection (true/false)
MINIO_SECURE=false

# Size threshold in MB for offloading to MinIO (0.1-100.0)
# DataFrames larger than this will be stored in MinIO instead of MongoDB/Redis
# Default: 0.5 MB to prevent MongoDB BSON 16MB limit issues
MINIO_SIZE_THRESHOLD_MB=0.5


# ============================================================================
# MLflow (Required for experiment tracking and model registry)
# ============================================================================
# MLflow tracking server URI
MLFLOW_TRACKING_URI=http://localhost:5000

# Default experiment name
MLFLOW_EXPERIMENT_NAME=default


# ============================================================================
# OpenTelemetry (Optional - for observability)
# ============================================================================
# OTLP exporter endpoint for traces and metrics
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Enable OTLP export (true/false)
# Set to true to send telemetry to observability backend (Jaeger, etc.)
ENABLE_OTLP_EXPORT=false


# ============================================================================
# Application Settings
# ============================================================================
# Environment: development, staging, production, test
ENVIRONMENT=development

# Enable debug mode (true/false)
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Session storage backend (mongodb, redis, memory, file)
# - mongodb: Recommended for API mode (persistent, supports large sessions)
# - file: Recommended for CLI mode (simple, no infrastructure)
# - redis: Fast but limited by memory
# - memory: For testing only (non-persistent)
STORAGE_BACKEND=mongodb


# ============================================================================
# Quick Start Guide
# ============================================================================
# Minimum Required Services for Local Development:
#
# 1. **Redis** (for job tracking and workers)
#    docker run -d -p 6379:6379 redis:alpine
#
# 2. **MongoDB** (for session persistence in API mode)
#    docker run -d -p 27017:27017 \
#      -e MONGO_INITDB_ROOT_USERNAME=admin \
#      -e MONGO_INITDB_ROOT_PASSWORD=admin123 \
#      mongo:latest
#
# 3. **MinIO** (for large DataFrame storage)
#    docker run -d -p 9010:9000 -p 9011:9011 \
#      -e MINIO_ROOT_USER=minioadmin \
#      -e MINIO_ROOT_PASSWORD=minioadmin \
#      minio/minio server /data --console-address ":9011"
#
#    Then create bucket:
#    mc alias set local http://localhost:9010 minioadmin minioadmin
#    mc mb local/maxa-sessions
#
# 4. **MLflow** (for experiment tracking)
#    pip install mlflow
#    mlflow server --host 0.0.0.0 --port 5000
#
# 5. **Celery Workers** (for async job execution)
#    celery -A src.workers.celery_app worker --loglevel=info
#
# Optional Services:
# - Jaeger (for distributed tracing): docker run -d -p 4317:4317 jaegertracing/all-in-one:latest
# - Snowflake (for data warehouse features): Configure credentials above


# ============================================================================
# Security Notes
# ============================================================================
# 1. NEVER commit .env files to version control
# 2. Keep sensitive credentials secure (use secrets management in production)
# 3. Use service accounts with minimum required permissions
# 4. Rotate credentials regularly
# 5. For production:
#    - Use managed services (Cloud SQL, ElastiCache, etc.)
#    - Enable encryption at rest and in transit
#    - Use IAM roles instead of access keys where possible
#    - Enable audit logging
#    - Use secrets management (Vault, AWS Secrets Manager, GCP Secret Manager)


# ============================================================================
# Troubleshooting
# ============================================================================
# If you encounter errors:
#
# 1. "Celery workers unavailable"
#    → Start Celery workers: celery -A src.workers.celery_app worker
#    → Or set async_mode=False in tool calls
#
# 2. "MongoDB BSON size limit"
#    → Large DataFrames automatically offload to MinIO if configured
#    → Reduce MINIO_SIZE_THRESHOLD_MB if seeing warnings
#
# 3. "No active session" in notebooks
#    → Session context now automatically set (fixed in refactoring)
#
# 4. "Connection refused" errors
#    → Check that required services are running (Redis, MongoDB, MinIO)
#    → Use provided Docker commands above
#
# 5. "Validation errors" in feature engineering
#    → Use get_tool_examples() to see correct parameter format
#    → Call list_available_transformations() first
